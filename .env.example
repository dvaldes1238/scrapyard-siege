# Deployment settings for `npm run deploy`. Copy to .env (git-ignored) and fill in.
# Log in first with `npx wrangler login` (see AGENTS.md for a least-privilege login), or set
# CLOUDFLARE_API_TOKEN for CI.

# Hostname to serve the game on. It must be a domain (zone) in your Cloudflare account; Cloudflare
# creates its DNS record and certificate. Leave empty to use https://<WORKER_NAME>.<account>.workers.dev.
DEPLOY_DOMAIN=

# Worker name in your Cloudflare account. Default: the "name" in wrangler.jsonc.
WORKER_NAME=

# Only needed if your login can access several Cloudflare accounts.
CLOUDFLARE_ACCOUNT_ID=
